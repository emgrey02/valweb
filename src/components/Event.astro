---
interface Props {
  title: string
  date: string
  location: string
  time: string
  timeEnd: string
  place: string
  program?: any
  info?: string
  key: string
  url?: string
}
const { title, date, location, time, timeEnd, place, program, info, key, url } = Astro.props

const dateOptions: object = {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: 'numeric',
  minute: 'numeric',
}

const formattedDate = new Date(`${date.split('-').join('/')} ${time}`).toLocaleDateString('en-US', dateOptions)
---

<script>
  let handleClick = (event: MouseEvent) => {
    let calEvent = event.target as HTMLElement
    let eventKey = calEvent.dataset.key?.split('-')[1]

    let programs = document.querySelectorAll('.program')
    let progArray = Array.from(programs)

    let prog = progArray.find((program) => {
      let programKey = program.getAttribute('data-key')?.split('-')[1]
      if (programKey === eventKey) {
        return program
      }
    })

    if (prog) {
      prog.classList.toggle('show')
      calEvent.firstElementChild?.classList.toggle('rotate-180')
    }
  }

  let arrows: NodeListOf<HTMLButtonElement> = document.querySelectorAll('.arrow')
  arrows.forEach((arrow) => arrow.addEventListener('click', handleClick))
</script>

<div class="flex flex-col gap-8 border-[1px] border-[var(--action-color)] p-4 md:flex-row md:justify-between">
  <div class="flex flex-col justify-between gap-4">
    <div>
      <p class="text-2xl text-[var(--action-color-state)]">{formattedDate}</p>
      <h2 class="mb-4 text-3xl font-extrabold text-[var(--font-color)]">{title}</h2>
    </div>
    {
      info && (
        <div class="max-w-[50ch]">
          <p>{info}</p>
        </div>
      )
    }
    {url && <a href={url}>more info</a>}
    <div class="">
      <p class="font-bold">{place}</p>
      <p>{location}</p>
    </div>
  </div>
  <div class="flex flex-col items-end justify-between gap-8">
    <add-to-calendar-button
      name={title}
      options="'Apple','Google'"
      location={`${place} ${location}`}
      startDate={date}
      endDate={date}
      startTime={time}
      endTime={timeEnd}
      timeZone="America/New_York"
      description={info}></add-to-calendar-button>
    {
      program && (
        <button class="arrow flex items-center justify-center gap-2" data-key={`btn-${key}`}>
          <svg
            id="progArrow"
            class="transition"
            width="14"
            height="18"
            viewBox="0 0 44 38"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M3 2.5L21.7639 35L40.5277 2.5"
              stroke="#363636"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Program
        </button>
      )
    }
  </div>
</div>
{
  program && (
    <div class="program" data-key={`p-${key}`}>
      <h3 class="mb-1 text-lg font-extralight">Program:</h3>
      <ul>
        {program?.map((data: { title: string; composer: string }) => (
          <li>
            {data.title}
            {data.composer && <span class="text-sm">- {data.composer}</span>}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style lang="scss">
  .program {
    display: none;
  }

  .show {
    display: block;
  }

  html.darkmode #progArrow path {
    stroke: var(--secondary-200);
  }
</style>
