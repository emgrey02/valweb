---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import ContactForm from '../components/ContactForm.astro'

import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import img from '../assets/img/valstrut.jpeg'
import img2 from '../assets/img/valshoulder.jpg'

import { Breadcrumbs, BreadcrumbsItem } from 'accessible-astro-components'
---

<DefaultLayout
  title="Contact"
  description="Get in touch with clarinetist Valerie Nuzzolo for performance inquiries, collaborations, or teaching opportunities."
>
  <div class="container flex flex-col gap-8">
    <Breadcrumbs>
      <BreadcrumbsItem label="Home" href="/" />
      <BreadcrumbsItem label="Contact" href="/contact" />
    </Breadcrumbs>
    <h1>Contact</h1>
    <Image
      src={img}
      alt="Valerie walking with her clarinet over her shoulder, in front of a garden"
      class="brightness-[85%] contrast-[120%]"
    />
    <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
      <div class="flex flex-col gap-8">
        <div class="flex gap-2">
          <Icon
            name="ion:happy-outline"
            class="text-4xl transition-all hover:rotate-180 hover:text-[var(--action-color-state)]"
          />
          <h2>Get in touch with Valerie</h2>
        </div>
        <ul class="list flex flex-col gap-4">
          <li>Private lessons</li>
          <li>Masterclasses</li>
          <li>Arranging</li>
          <li>Composition</li>
          <li>D'Addario Clinic</li>
        </ul>
      </div>
      <ContactForm />
    </div>
    <div class="grid grid-cols-1 items-center gap-16 md:grid-cols-2">
      <div>
        <h2>Follow Valerie</h2>
        <ul class="flex gap-4">
          <li>
            <a href="https://www.instagram.com/valerienuzzolo">
              <Icon name="ion:logo-instagram" class="self-start text-5xl" />
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/valerie.nuzzolo">
              <Icon name="ion:logo-facebook" class="self-start text-5xl" />
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/@valerienuzzolo8932">
              <Icon name="ion:logo-youtube" class="self-start text-5xl" />
            </a>
          </li>
        </ul>
      </div>
      <Image src={img2} alt="" />
    </div>
  </div>
</DefaultLayout>

<style>
  ul[class='flex flex-col gap-4 list'] li {
    display: flex;
    gap: 0.3em;
    font-size: 1.5em;
  }
  ul[class='flex flex-col gap-4 list'] li::before {
    content: '*';
    font-size: 2em;
  }
</style>
