---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import Quote from '../components/Quote.astro'
import Event from '../components/Event.astro'

import { Image } from 'astro:assets'

import img1 from '../assets/img/valcrisscross.jpg'
import img3 from '../assets/img/valcute.jpg'

import { Breadcrumbs, BreadcrumbsItem } from 'accessible-astro-components'

import events from '../calendar/events.json'

let calEvents = events.events.slice().map((event, index) => ({
  ...event,
  key: (index + 1).toString(),
}))

let pastEvents = calEvents
  .filter((event) => {
    const today = new Date()
    const eventDate = new Date(event.date)
    return eventDate < today
  })
  .sort((a, b) => {
    return new Date(b.date).getTime() - new Date(a.date).getTime()
  })

let upcomingEvents = calEvents
  .filter((event) => {
    const today = new Date()
    const eventDate = new Date(event.date)
    return eventDate >= today
  })
  .sort((a, b) => {
    return new Date(a.date).getTime() - new Date(b.date).getTime()
  })
---

<script is:inline src="https://cdn.jsdelivr.net/npm/add-to-calendar-button@2" async defer></script>

<DefaultLayout
  title="Calendar"
  description="View Valerie Nuzzolo’s calendar for upcoming clarinet performances, masterclasses, and events across the country. Stay tuned for updates!"
>
  <div class="container flex flex-col gap-8">
    <Breadcrumbs>
      <BreadcrumbsItem label="Home" href="/" />
      <BreadcrumbsItem label="Calendar" href="/calendar" />
    </Breadcrumbs>
    <h1>Calendar</h1>
    <Quote
      quote="Valerie’s musicianship is very diverse. She has such a great sound, a wide repertoire, and is a wonderful person to work with both in an ensemble and chamber setting."
      name="Michael Giunta"
      job="percussionist"
    />
    <p>Come to one of Valerie's performances!</p>
    <div class="flex flex-col gap-8">
      <h2>Upcoming Events</h2>
      {upcomingEvents.length == 0 && <div>Stay tuned for more events!</div>}
      {
        upcomingEvents.map((event) => (
          <Event
            title={event.title}
            info={event.info}
            date={event.date}
            location={event.location}
            time={event.time}
            timeEnd={event.timeEnd}
            place={event.place}
            program={event.program}
            url={event.url}
            key={event.key}
          />
        ))
      }
      <h2>Past Events</h2>
      {
        pastEvents.map((event) => (
          <Event
            title={event.title}
            info={event.info}
            date={event.date}
            location={event.location}
            time={event.time}
            timeEnd={event.timeEnd}
            place={event.place}
            program={event.program}
            url={event.url}
            key={event.key}
          />
        ))
      }
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <Image src={img1} alt="Valerie sitting criss-cross applesauce with her clarinet in the grass with a big smile" />
      <Image
        src={img3}
        alt="Valerie sitting criss-cross applesauce in the grass, giggling, while holding the detached bell of her clarinet to her right ear, and the rest of her clarinet upright in the other"
      />
    </div>
  </div>
</DefaultLayout>
